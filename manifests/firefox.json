{
  "manifest_version": 2,
  "name": "Veloura for YouTube Music",
  "version": "1.6",
  "description": "Apple Music-style synced lyrics for YouTube Music on the web: word-by-word highlighting and a background that follows the album art.",
  "browser_specific_settings": { "gecko": { "id": "veloura@example.local" } },
  "permissions": [
    "https://lrclib.net/*",
    "https://*.googleusercontent.com/*",
    "https://*.ytimg.com/*",
    "https://*.ggpht.com/*"
  ],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [{
    "matches": ["https://music.youtube.com/*"],
    "js": ["content.js"],
    "css": ["style.css"]
  }]
}
